# =====================================================================
# Mẫu biến môi trường. Sao chép thành .env rồi điền giá trị thật:
#     cp .env.example .env
# File .env KHÔNG được commit (đã có trong .gitignore).
# =====================================================================

# --- Django ---
# Sinh key mới bằng lệnh (trong .venv):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-a-new-one

# Danh sách host, cách nhau bằng dấu phẩy (prod bắt buộc có)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Chỉ cần ở prod, ví dụ: https://bookstore.local
DJANGO_CSRF_TRUSTED_ORIGINS=

# IP của reverse proxy (Nginx) được tin để đọc IP thật của người dùng từ header X-Real-IP.
# Máy dev chạy runserver: để trống. Máy chủ có Nginx cùng máy: 127.0.0.1 (prod bắt buộc có).
# Không điền IP nào khác: ai ở IP đó cũng giả được IP của người khác.
TRUSTED_PROXY_IPS=

# --- MySQL ---
# Mật khẩu của 2 tài khoản web. Lệnh `python manage.py db_setup` tạo tài khoản
# với đúng mật khẩu này; đổi ở đây thì chạy lại db_setup để đồng bộ.
# ≥ 12 ký tự, có hoa, thường, số, ký tự đặc biệt. Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(24) + '-Aa9')"
DB_NAME=bookstore
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CUSTOMER_USER=app_customer
DB_CUSTOMER_PASSWORD=
DB_STAFF_USER=app_staff
DB_STAFF_PASSWORD=
# Tài khoản riêng chỉ cho bảng phiên đăng nhập (django_session)
DB_SESSION_USER=app_session
DB_SESSION_PASSWORD=
# Tài khoản riêng chỉ để GHI bảng tài khoản (đăng ký, đăng nhập, hồ sơ, mật khẩu)
DB_AUTH_USER=app_auth
DB_AUTH_PASSWORD=
# Mật khẩu root và bookstore_migrate KHÔNG để ở đây mà ở database/.env.db.

# --- Email (gửi thư xác nhận) ---
# Để trống 2 dòng dưới thì thư được in ra terminal chạy runserver (máy dev, CI).
# Gmail: bật xác minh 2 bước cho tài khoản gửi, tạo App Password (16 ký tự)
# rồi điền vào EMAIL_HOST_PASSWORD. KHÔNG dùng mật khẩu Gmail thật.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Tên hiển thị người gửi, ví dụ: Secure Bookstore <ten.tai.khoan@gmail.com>
DEFAULT_FROM_EMAIL=

# --- Mã hóa cột nhạy cảm (SĐT) bằng AES-256-GCM ---
# 32 byte ngẫu nhiên, mã hóa base64. Sinh bằng:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# MẤT KHÓA = MẤT DỮ LIỆU đã mã hóa. Mỗi máy dev dùng khóa riêng; KHÔNG commit, KHÔNG gửi qua chat.
FIELD_ENCRYPTION_KEY=

# --- Thanh toán ---
# Chưa có cổng thanh toán thật. True = trang đơn hàng có nút "Thanh toán (mô phỏng)":
# khách bấm là đơn chuyển sang "Đã thanh toán", không có tiền thật nào chuyển đi.
# False hoặc để trống = nút hiện "Chưa cấu hình cổng thanh toán".
# Đổi giá trị thì chạy lại db_apply: lệnh cấp/thu hồi quyền gọi sp_payment_simulate theo cờ này.
PAYMENT_SIMULATION=False

# --- CAPTCHA ở trang đăng ký (Cloudflare Turnstile) ---
# Để trống cả hai dòng thì Turnstile TẮT (máy dev, CI): đăng ký vẫn chạy, `runserver` báo cảnh báo core.W001.
# Lấy key thật: Cloudflare Dashboard → Turnstile → Add widget (Managed, hostname localhost + tên miền thật).
# Thử nhanh không cần tài khoản: dùng key thử chính thức trong docs/captcha-turnstile.md mục 4.
# Secret key là bí mật như mật khẩu: KHÔNG commit, không gửi cho ai. Máy chủ thật bắt buộc có key thật.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
