# Django – sinh key: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-a-new-one

# Danh sách host, cách nhau bằng dấu phẩy (prod bắt buộc có)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Chỉ cần ở prod, ví dụ: https://bookstore.local
DJANGO_CSRF_TRUSTED_ORIGINS=

# IP Nginx được tin để đọc X-Real-IP: máy dev để trống, máy chủ có Nginx cùng máy điền 127.0.0.1 (không điền IP khác)
TRUSTED_PROXY_IPS=

# MySQL – mật khẩu tài khoản web (đổi thì chạy lại db_setup), sinh: python -c "import secrets; print(secrets.token_urlsafe(24) + '-Aa9')"
DB_NAME=bookstore
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CUSTOMER_USER=app_customer
DB_CUSTOMER_PASSWORD=
DB_STAFF_USER=app_staff
DB_STAFF_PASSWORD=
# Tài khoản riêng chỉ cho bảng phiên đăng nhập (django_session)
DB_SESSION_USER=app_session
DB_SESSION_PASSWORD=
# Tài khoản riêng chỉ để GHI bảng tài khoản (đăng ký, đăng nhập, hồ sơ, mật khẩu)
DB_AUTH_USER=app_auth
DB_AUTH_PASSWORD=
# Mật khẩu root và bookstore_migrate KHÔNG để ở đây mà ở database/.env.db.

# Email – để trống thì thư in ra terminal; Gmail dùng App Password 16 ký tự, không dùng mật khẩu Gmail thật
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Tên hiển thị người gửi, ví dụ: Secure Bookstore <ten.tai.khoan@gmail.com>
DEFAULT_FROM_EMAIL=

# Khóa AES-256-GCM (mất khóa = mất dữ liệu, không commit), sinh: python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
FIELD_ENCRYPTION_KEY=

# Thanh toán mô phỏng: True bật nút "Thanh toán (mô phỏng)"; đổi giá trị thì chạy lại db_apply
PAYMENT_SIMULATION=False

# Cloudflare Turnstile ở trang đăng ký: để trống thì tắt; key thật và key thử xem docs/captcha-turnstile.md (secret không commit)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sao lưu CSDL (docs/sao-luu-csdl.md) – thư mục bản sao lưu, để trống = <repo>/backups
BACKUP_DIR=
# Thư mục thứ hai để chép thêm một bản (ổ khác, USB, thư mục đồng bộ cloud). Để trống = không chép.
BACKUP_OFFSITE_DIR=
# Nơi lệnh db_backup_export ghi file .sql trần để demo. Để trống = <repo>/backups/plain.
BACKUP_EXPORT_DIR=
# Tiền tố gọi mysqldump/mysql: Docker điền "sudo docker compose exec -T db", MySQL cài thường để trống
BACKUP_DUMP_PREFIX=
