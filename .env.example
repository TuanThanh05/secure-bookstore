# =====================================================================
# Mẫu biến môi trường. Sao chép thành .env rồi điền giá trị thật:
#     cp .env.example .env
# File .env KHÔNG được commit (đã có trong .gitignore).
# =====================================================================

# --- Django ---
# Sinh key mới bằng lệnh (trong .venv):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-a-new-one

# Danh sách host, cách nhau bằng dấu phẩy (prod bắt buộc có)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Chỉ cần ở prod, ví dụ: https://bookstore.local
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- MySQL ---
# Mật khẩu của 2 tài khoản web. Lệnh `python manage.py db_setup` tạo tài khoản
# với đúng mật khẩu này; đổi ở đây thì chạy lại db_setup để đồng bộ.
# ≥ 12 ký tự, có hoa, thường, số, ký tự đặc biệt. Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(24) + '-Aa9')"
DB_NAME=bookstore
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CUSTOMER_USER=app_customer
DB_CUSTOMER_PASSWORD=
DB_STAFF_USER=app_staff
DB_STAFF_PASSWORD=
# Mật khẩu root và bookstore_migrate KHÔNG để ở đây mà ở database/.env.db.

# --- Email (gửi thư xác nhận) ---
# Để trống 2 dòng dưới thì thư được in ra terminal chạy runserver (máy dev, CI).
# Gmail: bật xác minh 2 bước cho tài khoản gửi, tạo App Password (16 ký tự)
# rồi điền vào EMAIL_HOST_PASSWORD. KHÔNG dùng mật khẩu Gmail thật.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Tên hiển thị người gửi, ví dụ: Secure Bookstore <ten.tai.khoan@gmail.com>
DEFAULT_FROM_EMAIL=
