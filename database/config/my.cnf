# =====================================================================
# Cấu hình MySQL 8.4 cho secure-bookstore (mục D của checklist).
# compose.yaml gắn file này vào /etc/mysql/conf.d/bookstore.cnf (chỉ đọc).
# Sửa xong: docker compose restart db
#
# Máy cài MySQL thường (Windows): KHÔNG bắt buộc. Muốn giống máy demo thì
# chép phần [mysqld] dưới đây vào my.ini (xem database/README.md), trừ
# skip-name-resolve và secure_file_priv (đường dẫn khác).
# =====================================================================
[mysqld]

# --- Mạng ---
# Trong container MySQL phải nghe trên mọi giao diện của container,
# nhưng compose.yaml chỉ mở cổng ra 127.0.0.1 của máy chủ:
# máy khác trong mạng LAN không kết nối được cổng 3306.
bind-address      = 0.0.0.0
# So khớp tài khoản theo IP, không tra DNS (tránh giả mạo tên máy, nhanh hơn)
skip-name-resolve = ON

# --- Mã hóa kết nối (TLS) ---
# Từ chối kết nối TCP không mã hóa. Image mysql tự sinh chứng chỉ khi khởi tạo.
# Kết nối qua socket bên trong container (root, healthcheck) vẫn được phép.
require_secure_transport = ON

# --- Đọc/ghi file từ SQL ---
# Cấm LOAD DATA LOCAL INFILE (đọc file trên máy client)
local_infile      = OFF
# LOAD DATA / SELECT ... INTO OUTFILE chỉ trong thư mục này;
# thêm vào đó không tài khoản ứng dụng nào có quyền FILE.
secure_file_priv  = /var/lib/mysql-files

# --- Giới hạn tài nguyên (chống DoS) ---
max_connections    = 100
# Câu SELECT chạy quá 5 giây bị hủy
max_execution_time = 5000

# --- Ký tự, múi giờ ---
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
# Lưu thời gian theo UTC, khớp Django USE_TZ = True
default-time-zone    = '+00:00'

# Chính sách mật khẩu (validate_password) KHÔNG đặt ở đây: lệnh
# `python manage.py db_setup` cài component và lưu cấu hình bằng SET PERSIST,
# chạy giống nhau trên Docker lẫn Windows.

# --- Lịch chạy tự động (sp_cancel_expired_orders về sau) ---
event_scheduler = ON
