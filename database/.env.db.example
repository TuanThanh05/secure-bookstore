# =====================================================================
# Mật khẩu QUẢN TRỊ CSDL. Sao chép thành database/.env.db rồi điền:
#     cp database/.env.db.example database/.env.db      (Linux: chmod 600 database/.env.db)
#     copy database\.env.db.example database\.env.db    (Windows)
# File database/.env.db KHÔNG được commit (.gitignore đã chặn).
#
# Ai đọc file này:
#   - Docker Compose: lấy MYSQL_ROOT_PASSWORD khi tạo container LẦN ĐẦU.
#   - Lệnh db_setup, db_apply: đăng nhập root.
#   - settings/migrate.py: lấy DB_MIGRATE_PASSWORD khi chạy migrate/createsuperuser/test.
# Web lúc chạy (settings dev/prod) KHÔNG đọc file này.
#
# Máy cài MySQL thường: MYSQL_ROOT_PASSWORD = mật khẩu root bạn đặt lúc cài.
# Docker: tự chọn, sinh bằng lệnh dưới. Đổi về sau phải dùng ALTER USER.
#
# Mật khẩu phải qua được validate_password MEDIUM: ≥ 12 ký tự, có chữ hoa,
# chữ thường, số, ký tự đặc biệt. Sinh bằng (trong .venv):
#   python -c "import secrets; print(secrets.token_urlsafe(24) + '-Aa9')"
# =====================================================================

MYSQL_ROOT_PASSWORD=
DB_MIGRATE_PASSWORD=
