# Mật khẩu quản trị CSDL: chép thành database/.env.db (không commit, chmod 600), mật khẩu ≥ 12 ký tự đủ 4 loại, sinh: python -c "import secrets; print(secrets.token_urlsafe(24) + '-Aa9')"

MYSQL_ROOT_PASSWORD=
DB_MIGRATE_PASSWORD=

# Mật khẩu tài khoản chỉ đọc bookstore_backup (db_setup tạo theo mật khẩu này)
DB_BACKUP_PASSWORD=

# Khóa mã hóa bản sao lưu, khác FIELD_ENCRYPTION_KEY, mất khóa = mất mọi bản sao lưu, sinh: python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
BACKUP_ENCRYPTION_KEY=
